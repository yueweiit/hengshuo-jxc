# Only these reviewed frontend values and empty examples belong in source control.
.env.*
!**/.env.example
!jxc-web/.env.development
!jxc-web/.env.production
!jxc-web/.env.demo
**/config.env
**/secrets/
**/private/
*.pem
*.key
