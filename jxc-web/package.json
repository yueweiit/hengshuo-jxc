{
  "name": "jxc-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo --port 5174",
    "build:demo": "vue-tsc -b && vite build --mode demo",
    "test": "node --test tests/*.test.mjs",
    "test:e2e:core": "node --test e2e/*.test.mjs",
    "test:e2e:prepare": "node e2e/preflight.mjs",
    "test:e2e": "node e2e/run.mjs",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@revolist/vue3-datagrid": "4.29.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.7",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "msw": "^3.0.3",
    "sass": "^1.105.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
