        "jsCode": "const expected=$('Prepare image requests').all().map(i=>i.json);const actual=$input.all().map(i=>i.json);\nif(expected.length===1&&expected[0].skipped===true)return [{json:{imageResults:[]}}];\nif(expected.length!==actual.length)throw new Error('图片结果数量不完整');\nreturn [{json:{imageResults:expected.map((item,index)=>{const r=actual[index];const hits=r.statusCode===200&&r.body?.status==='ok'&&Array.isArray(r.body.search?.hits)?r.body.search.hits:null;\nreturn hits===null?{queryAssetId:item.request.queryAssetId,status:'FAILED',reason:'受限图片检索失败或响应不完整；请查询Python桥接状态',hits:[]}:{queryAssetId:item.request.queryAssetId,status:hits.length?'FOUND':'NOT_FOUND',reason:'正式图库检索结果',hits};})}}];",
