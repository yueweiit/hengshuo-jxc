      "parameters": {
        "jsCode": "const prepared=$('Prepare explanation').first().json;let explanation;\nif(prepared.needsExplanation===false){explanation={status:'NOT_REQUESTED',message:'没有可读的来源图与候选图配对，尚未进行图文核对',candidateIds:[],candidateChecks:prepared.evidence.candidates.map(c=>({productId:c.productId,imageMatch:'NO_INPUT',imageReason:prepared.reviewInput.errors.find(e=>e.productId===c.productId)?.reason||'此候选没有可用的图像配对',specMatch:'NOT_CHECKED',specReason:'尚未确认照片同款，未继续核对规格'}))};}\nelse {const r=$input.first().json;\nif(r.statusCode!==200)explanation={status:'UNAVAILABLE',message:'模型连接、权限、配额或服务不可用，原始候选保留，图文核对未完成',candidateIds:[]};\nelse try{const x=JSON.parse(r.body.choices[0].message.content);const candidates=prepared.evidence.candidates,allowed=new Set(candidates.map(c=>c.productId)),seen=new Set(),paired=new Set(prepared.reviewInput.pairs.map(p=>p.productId));\nif(!x||typeof x!=='object'||Array.isArray(x)||Object.keys(x).some(k=>!['status','message','candidateIds','candidateChecks'].includes(k))||x.status!=='READY'||typeof x.message!=='string'||!x.message.trim()||x.message.length>8000||!Array.isArray(x.candidateIds)||x.candidateIds.some(id=>!allowed.has(id))||!Array.isArray(x.candidateChecks)||x.candidateChecks.length!==candidates.length)throw new Error('核对结构无效');\nfor(const c of x.candidateChecks){if(!c||Object.keys(c).sort().join(',')!==['productId','imageMatch','imageReason','specMatch','specReason'].sort().join(',')||!allowed.has(c.productId)||seen.has(c.productId)||!['SAME','DIFFERENT','UNCERTAIN','NO_INPUT'].includes(c.imageMatch)||!['MATCH','CONFLICT','MISSING','NOT_CHECKED'].includes(c.specMatch)||!['imageReason','specReason'].every(k=>typeof c[k]==='string'&&c[k].trim()&&c[k].length<=2000)||(!paired.has(c.productId))!==(c.imageMatch==='NO_INPUT')||c.imageMatch!=='SAME'&&c.specMatch!=='NOT_CHECKED'||c.imageMatch==='SAME'&&c.specMatch==='NOT_CHECKED')throw new Error('核对顺序或图片依据无效');\nseen.add(c.productId);const candidate=candidates.find(v=>v.productId===c.productId),missing=!prepared.evidence.sourceInput?.productSpec?.trim()||!candidate.product?.spec?.trim();if(c.imageMatch==='SAME'&&(!!missing!==(c.specMatch==='MISSING')))throw new Error('缺失规格不能猜测');if(x.candidateIds.includes(c.productId)&&!(c.imageMatch==='SAME'&&c.specMatch==='MATCH'))throw new Error('冲突候选不能推荐');}explanation=x;\n}catch{explanation={status:'FAILED',message:'模型图文核对解析失败、依据不完整或顺序无效，原始候选已保留',candidateIds:[]};}}\nreturn [{json:{evidence:prepared.evidence,explanation}}];",
        "mode": "runOnceForAllItems"
      }
