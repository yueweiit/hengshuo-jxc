# Copy to an operator-owned secret env file outside the repository; fill all secrets explicitly.
# Never point this example at an existing business database.
JXC_BIND_ADDRESS=127.0.0.1
JXC_PORT=8080
JXC_DB_URL=jdbc:postgresql://127.0.0.1:55438/jxc_m01_isolated
JXC_DB_USER=jxc_app
JXC_DB_PASSWORD=
JXC_MIGRATION_USER=jxc_owner
JXC_MIGRATION_PASSWORD=
JXC_STORAGE_ENDPOINT=http://127.0.0.1:59000
JXC_STORAGE_ACCESS_KEY=
JXC_STORAGE_SECRET_KEY=
JXC_STORAGE_BUCKET=jxc-evidence
# Base64 of exactly 32 operator-owned random bytes; required to save original bank account data.
JXC_BANK_ENCRYPTION_KEY=
JXC_TEST_POSTGRES_PASSWORD=
JXC_TEST_MINIO_ROOT_USER=
JXC_TEST_MINIO_ROOT_PASSWORD=
# Explicit existing 0600 operator JSON. Never place the admin password in argv.
JXC_BOOTSTRAP_CONFIG_FILE=
# Offline bootstrap requires an already built executable jar.
JXC_APP_JAR=
