# Copy outside the checkout, mode 0600. All identities/digests/ports require actual review.
# Intended public host: erp.example.com. DNS/TLS and the existing host proxy are not configured by this env file.
JXC_APPLICATION_IMAGE=
JXC_GATEWAY_IMAGE=
JXC_POSTGRES_IMAGE=
# Use reviewed target-inspect full sha256:<64 lowercase hex> imageId or repository@sha256 manifest digest.
# Keep source OCI index/child/config mapping; never disguise configId as repository@manifest.
# SeaweedFS security build required; official 4.48 image alone failed the security gate.
JXC_OBJECT_IMAGE=
JXC_EXPECT_DATABASE=
JXC_DB_URL=
JXC_DB_USER=
JXC_MIGRATION_USER=
# Dedicated backend endpoint: http://objects:9000 (no host object ports).
JXC_STORAGE_ENDPOINT=
JXC_STORAGE_BUCKET=
JXC_WORKBENCH_WORKER_ASSIGNMENTS=
JXC_HTTP_BIND=
JXC_HTTPS_BIND=
JXC_BACKEND_NETWORK=
JXC_SECRET_DIR=
# Install object_s3_runtime.json here, UID/GID1000:1000, mode0400;
# its only identity has Read/List/Write:<exact JXC_STORAGE_BUCKET>, no Admin.
JXC_PG_VOLUME=
JXC_OBJECT_VOLUME=
JXC_WAL_ARCHIVE_DIR=
